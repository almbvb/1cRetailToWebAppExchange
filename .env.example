# Пример настроек. Скопируйте в .env и заполните. Файл .env не коммитится.
# Значения по умолчанию указаны в комментариях и заданы в backend/app/config.py.

# --- Приложение ---
# dev | prod
APP_ENV=
# Порт backend (по умолчанию 8090)
APP_PORT=
# Случайная строка не короче 32 символов (подпись сессий и кодов входа)
SECRET_KEY=
# Часовой пояс магазина (по умолчанию Europe/Moscow)
TIMEZONE=
# Адрес фронтенда для CORS в разработке (по умолчанию http://localhost:3000)
FRONTEND_ORIGIN=

# --- База данных PostgreSQL ---
# postgresql+psycopg://<пользователь>:<пароль>@127.0.0.1:5433/<база>
DATABASE_URL=

# --- Приём данных из 1С (API приложения, api_spec.md раздел 3) ---
# Базовый адрес для настроек 1С: http://localhost:8090/exchange/1c
# HTTP Basic: логин и пароль, которые указываются в «Настройках обмена с приложением» в 1С
EXCHANGE_BASIC_USER=
EXCHANGE_BASIC_PASSWORD=
# Bearer-токены через запятую (необязательно)
EXCHANGE_BEARER_TOKENS=
# Предел тела картинки в байтах (по умолчанию 4194304 = 4 МБ) и в мегапикселях (по умолчанию 40)
IMAGE_MAX_BYTES=
IMAGE_MAX_MEGAPIXELS=

# --- API 1С (вызывает сайт, api_spec.md раздел 2) ---
# http://localhost/rt/hs/abv_app/v1
ONEC_API_BASE_URL=
ONEC_API_USER=
ONEC_API_PASSWORD=
# GUID магазина приложения в 1С
ONEC_STORE_ID=
# Таймаут ожидания ответа 1С, секунд (по умолчанию 30)
ONEC_API_TIMEOUT=

# --- Заказы ---
# Префикс номера заказа (по умолчанию D-), номер до 11 символов
ORDER_NUMBER_PREFIX=

# --- Почта (коды входа) ---
# console — код пишется в лог и в «ящик разработчика»; smtp — настоящая отправка
MAIL_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Файлы ---
# Папка для картинок и превью (по умолчанию var/media)
MEDIA_DIR=
